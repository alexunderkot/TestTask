{
    "name": "C++",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "forwardPorts": [8080],
    "portsAttributes": {
        "8080": {
            "label": "Hello C++ World",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools"
            ]
        }
    },
    "postCreateCommand": "g++ --version; echo '✅ C++ ready!'"
}